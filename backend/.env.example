# Cloud: paste Neon connection string (overrides vars below)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# PostgreSQL connection (local)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD"DB Password"
POSTGRES_DB="DB Name"

# JWT / security
SECRET_KEY=change-this-to-a-long-random-secret-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080 #token limit time

# CORS (comma-separated list of allowed frontend origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed default demo accounts on startup
SEED_DEMO_DATA=true
