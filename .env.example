# Shared Docker environment template
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=video_lecture_transcript
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://postgres:change-me@db:5432/video_lecture_transcript
SECRET_KEY=change-me-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true

# RAG / OpenRouter-compatible LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=tiny
WHISPER_WORD_TIMESTAMPS=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=/data/chroma
CHROMA_COLLECTION=transcripts_multilingual
MEDIA_DIR=/data/media

# Frontend
VITE_API_URL=/api
VITE_RAG_API_URL=
