# Cloud: paste Neon connection string
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# CORS — your Vercel frontend URL in production
# CORS_ORIGINS=https://your-app.vercel.app

# PostgreSQL connection (local)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Manojkumar@c1
POSTGRES_DB=video_lecture_transcript

# Security — MUST match the backend's SECRET_KEY so the RAG service can validate
# the same JWTs and scope every transcript/query to the signed-in user. If these
# differ, logged-in users won't get their own private knowledge base.
SECRET_KEY=change-me
ALGORITHM=HS256

# Groq LLM (get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Whisper model: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Word-level timestamps: more precise citation boundaries, but slower. (true/false)
WHISPER_WORD_TIMESTAMPS=false

# Embeddings (local sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB persistent storage directory and collection name
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=transcripts_multilingual

# Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Drop retrieved chunks below this cosine similarity before answering.
# 0.0 = keep everything (default). Raise (e.g. 0.2) so the assistant replies
# "not enough information" instead of answering from irrelevant matches.
RETRIEVAL_MIN_SIMILARITY=0.0
