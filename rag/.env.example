# Cloud: paste Neon connection string
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# CORS — your Vercel frontend URL in production
# CORS_ORIGINS=https://your-app.vercel.app

# PostgreSQL connection (local)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=video_lecture_transcript

# Groq LLM (get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Whisper model: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# Embeddings (local sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistent storage directory and collection name
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=transcripts

# Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
