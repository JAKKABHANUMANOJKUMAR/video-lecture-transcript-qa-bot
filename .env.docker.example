# Copy to .env.docker and fill in before: docker compose --env-file .env.docker up -d --build

POSTGRES_PASSWORD="DB Password"
SECRET_KEY=change-me-long-random-secret-key
GROQ_API_KEY=gsk_your_groq_key_here

# Public URL users open in browser (your VM IP or domain)
# Examples: http://123.45.67.89   or   http://askora.example.com
PUBLIC_ORIGIN=http://YOUR_SERVER_IP

# tiny = less RAM (good for small free VMs); base = better transcription
WHISPER_MODEL=tiny
